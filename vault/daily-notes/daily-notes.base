filters:
  or:
    - /daily-notes\/\d\d\d\d\/.*\/*.md/.matches(file.path)
properties:
  file.name:
    displayName: Link
views:
  - type: table
    name: Table
    order:
      - file.path
      - file.name
      - weather
      - creation date
    sort:
      - property: creation date
        direction: DESC
